# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String
# For MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster-url>/college_complaint_db?retryWrites=true&w=majority
# For Local MongoDB: mongodb://127.0.0.1:27017/college_complaint_db
MONGODB_URI=mongodb://127.0.0.1:27017/college_complaint_db

# JWT Secret Key for token signing
JWT_SECRET=college_complaint_management_super_secure_jwt_secret_key_2026_!@#$

# Frontend Client URL for CORS
CLIENT_URL=http://localhost:5173
